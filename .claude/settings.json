{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(**/eval/refs/**)",
      "Edit(**/eval/thresholds.json)",
      "Bash(git*push* --force*)",
      "Bash(git*push* -f*)",
      "Bash(git*push* +*)",
      "Bash(git*push* main)",
      "Bash(git*push* main *)",
      "Bash(git*push*:main)",
      "Bash(git*push*:main *)"
    ]
  }
}
